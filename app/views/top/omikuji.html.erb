<div class="container">
  <div class="row min-vh-100 align-items-center justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-lg border-0">
        <div class="card-body text-center p-5">
          <h1 class="card-title mb-4 text-secondary">
            ☆きちみくじ結果☆
          </h1>
          
          <!-- 結果表示エリア -->
          <div class="<%= @styles[:bg] %> <%= @styles[:text] %> p-5 rounded text-center">
            <h2 class="<%= @styles[:size] %> fw-bold mb-0"><%= @fortune.result %></h2>
          </div>
          
          <!-- メッセージを表示 -->
            <p class="display-6 fw-bold mb-4 mt-4">
              <%= @fortune.description %>
            </p>
          
          <!-- ボタンエリア -->
          <div class="d-grid gap-3">
            <%= button_to 'もう一度引く', omikuji_path, 
                method: :get, 
                class: 'btn btn-primary btn-lg' %>
            <%= link_to 'トップに戻る', root_path, 
                class: 'btn btn-outline-secondary btn-lg' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>